require_relative './podspec_versions.rb'
install! 'cocoapods', :warn_for_unused_master_specs_repo => false
$deploymentTarget = '15.0'
platform :ios, $deploymentTarget
inhibit_all_warnings!

target 'iosApp' do
  use_frameworks!
  platform :ios, $deploymentTarget
    # Third-party
    pod 'AppCenter/Distribute'
    pod 'FirebaseCore'
    pod 'FirebaseAnalytics'

    #  Multiplatform
    pod 'Shared', :path => '../shared'

    ENV['TRIKOT_FRAMEWORK_NAME']='Shared'
    properties = load_properties('../gradle/libs.versions.toml')
    pod 'Trikot/kword', :git => 'git@github.com:mirego/trikot.git', :tag => properties['trikot'], :inhibit_warnings => true

    pod 'SwiftLint'

    pod 'Pilot/Components', :git => 'git@github.com:mirego/viewmodel-pilot.git', :tag => properties['pilot'], :inhibit_warnings => true
    pod 'Pilot/Components.Kingfisher', :git => 'git@github.com:mirego/viewmodel-pilot.git', :tag => properties['pilot'], :inhibit_warnings => true
    pod 'Pilot/Navigation', :git => 'git@github.com:mirego/viewmodel-pilot.git', :tag => properties['pilot'], :inhibit_warnings => true
    pod 'Pilot/ViewModel', :git => 'git@github.com:mirego/viewmodel-pilot.git', :tag => properties['pilot'], :inhibit_warnings => true
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = 15.0
    end
  end
end
